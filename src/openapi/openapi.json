{
  "openapi": "3.0.3",
  "info": {
    "title": "Monitoring API",
    "version": "2.0.0",
    "description": "Status feed (`/api/v1/status/`) and management API (`/api/v2`). Auth uses personal tokens from `/settings/api/` (`Authorization: Bearer mnt_...` or `X-Api-Token`). Rights follow the token owner's UI ACL. Management responses use envelope `{status:0,data,meta?}`; errors `{status:1,error}` with HTTP 401/403/404/422/429. MCP at `POST /mcp/` mirrors v2 tools (not listed as REST paths). Do not enable `api_enabled` on every monitor — it only opts into `/api/v1/status/`."
  },
  "servers": [
    {
      "url": "/",
      "description": "Current host"
    }
  ],
  "tags": [
    {"name": "status", "description": "Opt-in status feed"},
    {"name": "monitors", "description": "Monitors CRUD"},
    {"name": "notify", "description": "Notification channels"},
    {"name": "signatures", "description": "Alert signature text blocks"},
    {"name": "workers", "description": "Check workers / handlers"},
    {"name": "maintenances", "description": "Planned maintenance windows"},
    {"name": "dockers", "description": "Docker hosts"},
    {"name": "servers", "description": "Host agents (push metrics)"},
    {"name": "users", "description": "Users (read-only)"},
    {"name": "groups", "description": "Groups (read-only)"},
    {"name": "logs", "description": "Audit logs"},
    {"name": "permissions", "description": "Object ACL"}
  ],
  "paths": {
    "/api/v1/status/": {
      "get": {
        "tags": ["status"],
        "summary": "List exposed monitor statuses",
        "description": "Returns only monitors the token user can read that have api_enabled (Expose in /api/v1/status/). Folders and disabled monitors are omitted. Cached ~20s; >1 req / 5s per token → 429.",
        "security": [{"BearerAuth": []}, {"ApiTokenHeader": []}],
        "responses": {
          "200": {
            "description": "Status payload",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/StatusResponse"},
                "example": {
                  "status": 0,
                  "generated_at": 1756890000,
                  "resources": [
                    {
                      "id": 12,
                      "title": "example.com",
                      "description_ru": "",
                      "description_en": "",
                      "check_url": "https://example.com/",
                      "status": "up",
                      "avg_response_time_ms": 142,
                      "ssl_expire_time": 1798761600,
                      "ssl_expire_at": "2026-12-31",
                      "availability": {"1m": null, "5m": 100, "10m": 99.5, "1h": 99.8, "4h": 99.91, "8h": 99.93},
                      "workers": [{"id": 3, "title": "msk-1", "status": "up", "availability": {"1m": null, "5m": 100, "10m": 100, "1h": 99.7, "4h": 99.9, "8h": 99.92}}],
                      "maintenances": []
                    }
                  ],
                  "maintenances": []
                }
              }
            }
          },
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "429": {"$ref": "#/components/responses/RateLimited"}
        }
      }
    },
    "/api/v2/monitors/": {
      "get": {
        "tags": ["monitors"],
        "summary": "List monitors",
        "security": [{"BearerAuth": []}, {"ApiTokenHeader": []}],
        "responses": {
          "200": {
            "description": "Envelope with monitor list",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/EnvelopeMonitorList"}
              }
            }
          },
          "401": {"$ref": "#/components/responses/Unauthorized"}
        }
      },
      "post": {
        "tags": ["monitors"],
        "summary": "Create monitor",
        "description": "Types: 0 HTTPS, 1 folder, 2 TCP, 3 ping, 4 docker, 5–7 exporters, 8 HTTP JSON, 9 external. Type-specific fields: url/method/response_code/ssl_* (HTTPS/JSON); host/port (TCP/exporters); host (ping); docker/container (docker); external_hash auto (external). Link workers[] and notify[] by id. api_enabled only for /api/v1/status/ opt-in.",
        "security": [{"BearerAuth": []}, {"ApiTokenHeader": []}],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/MonitorWrite"},
              "example": {
                "title": "example.com",
                "type": 0,
                "url": "https://example.com/",
                "method": "GET",
                "status": 1,
                "response_code": "200",
                "repeat_seconds": 60,
                "timeout": 10,
                "ssl_verify": 1,
                "ssl_verify_host": 1,
                "workers": [1, 2],
                "notify": [1],
                "api_enabled": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created monitor",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/EnvelopeMonitor"}
              }
            }
          },
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "422": {"$ref": "#/components/responses/ValidationError"}
        }
      }
    },
