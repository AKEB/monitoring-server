    "/api/v2/logs/": {
      "get": {
        "tags": ["logs"],
        "summary": "List audit logs",
        "security": [{"BearerAuth": []}, {"ApiTokenHeader": []}],
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": true,
            "schema": {"type": "string", "format": "date", "example": "2026-01-01"},
            "description": "YYYY-MM-DD"
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "schema": {"type": "string", "format": "date", "example": "2026-01-31"},
            "description": "YYYY-MM-DD"
          },
          {
            "name": "object",
            "in": "query",
            "schema": {"type": "string"},
            "description": "Optional object filter (e.g. Monitors)"
          },
          {
            "name": "object_id",
            "in": "query",
            "schema": {"type": "integer"},
            "description": "Optional object id filter"
          }
        ],
        "responses": {
          "200": {
            "description": "Logs",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/EnvelopeList"}
              }
            }
          },
          "403": {"$ref": "#/components/responses/Forbidden"},
          "422": {"$ref": "#/components/responses/ValidationError"}
        }
      }
    },
    "/api/v2/{resource}/{id}/permissions/": {
      "parameters": [
        {
          "name": "resource",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "enum": ["monitors", "notify", "signatures", "workers", "maintenances", "dockers", "servers"]
          }
        },
        {"$ref": "#/components/parameters/IdPath"}
      ],
      "get": {
