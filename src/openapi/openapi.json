  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "mnt_...",
        "description": "Personal API token from /settings/api/"
      },
      "ApiTokenHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Api-Token",
        "description": "Same token as Bearer, alternative header"
      }
    },
    "parameters": {
      "IdPath": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {"type": "integer", "minimum": 1}
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Missing or invalid token",
        "content": {
          "application/json": {
            "schema": {"$ref": "#/components/schemas/EnvelopeError"},
            "example": {"status": 1, "error": "Unauthorized"}
          }
        }
      },
      "Forbidden": {
        "description": "ACL denied",
        "content": {
          "application/json": {
            "schema": {"$ref": "#/components/schemas/EnvelopeError"},
            "example": {"status": 1, "error": "Forbidden"}
          }
        }
      },
      "NotFound": {
        "description": "Not found",
        "content": {
          "application/json": {
            "schema": {"$ref": "#/components/schemas/EnvelopeError"},
            "example": {"status": 1, "error": "Not found"}
          }
        }
      },
      "ValidationError": {
        "description": "Validation failed",
        "content": {
          "application/json": {
            "schema": {"$ref": "#/components/schemas/EnvelopeError"}
          }
        }
      },
      "RateLimited": {
        "description": "Too many requests",
        "content": {
          "application/json": {
            "schema": {"$ref": "#/components/schemas/EnvelopeError"},
            "example": {"status": 1, "error": "Too many requests"}
          }
        }
      }
    },
    "schemas": {
      "EnvelopeError": {
        "type": "object",
        "required": ["status", "error"],
        "properties": {
          "status": {"type": "integer", "enum": [1]},
          "error": {"type": "string"}
        }
      },
      "EnvelopeMeta": {
        "type": "object",
        "properties": {
          "total": {"type": "integer"}
        },
        "additionalProperties": true
      },
      "EnvelopeList": {
        "type": "object",
        "required": ["status", "data"],
        "properties": {
          "status": {"type": "integer", "enum": [0]},
          "data": {"type": "array", "items": {"type": "object"}},
          "meta": {"$ref": "#/components/schemas/EnvelopeMeta"}
        }
      },
      "EnvelopeObject": {
        "type": "object",
        "required": ["status", "data"],
        "properties": {
          "status": {"type": "integer", "enum": [0]},
          "data": {"type": "object"},
          "meta": {"$ref": "#/components/schemas/EnvelopeMeta"}
        }
      },
      "EnvelopeDeleted": {
        "type": "object",
        "properties": {
          "status": {"type": "integer", "enum": [0]},
          "data": {
            "type": "object",
            "properties": {
              "id": {"type": "integer"},
              "deleted": {"type": "boolean"}
            }
          }
        }
      },
      "Monitor": {
        "type": "object",
        "properties": {
          "id": {"type": "integer"},
          "title": {"type": "string"},
          "type": {"type": "integer", "description": "0 HTTPS, 1 folder, 2 TCP, 3 ping, 4 docker, 5–7 exporters, 8 HTTP JSON, 9 external, 10–16 server agent metrics, 17 server listening port"},
          "status": {"type": "integer", "description": "0 disabled, 1 enabled"},
          "api_enabled": {"type": "integer", "description": "Opt-in for GET /api/v1/status/ only"},
          "url": {"type": "string"},
          "host": {"type": "string"},
          "port": {"type": "integer", "minimum": 0, "maximum": 65535},
          "port_protocol": {"type": "string", "enum": ["tcp", "udp"], "description": "For type 17 (server listening port)"},
          "server": {"type": "integer", "description": "Host agent server id (types 10–17)"},
          "method": {"type": "string"},
          "response_code": {"type": "string"},
          "repeat_seconds": {"type": "integer"},
          "timeout": {"type": "integer"},
          "workers": {"type": "array", "items": {"type": "integer"}},
          "notify": {"type": "array", "items": {"type": "integer"}},
          "signature_id": {"type": "integer"},
          "parent_id": {"type": "integer"}
        },
        "additionalProperties": true
      },
      "MonitorWrite": {
        "type": "object",
        "properties": {
          "title": {"type": "string"},
          "type": {"type": "integer"},
          "status": {"type": "integer"},
          "api_enabled": {"oneOf": [{"type": "boolean"}, {"type": "integer"}]},
          "api_description_ru": {"type": "string"},
          "api_description_en": {"type": "string"},
          "url": {"type": "string"},
          "host": {"type": "string"},
          "port": {"type": "integer", "minimum": 0, "maximum": 65535},
          "port_protocol": {"type": "string", "enum": ["tcp", "udp"], "description": "For type 17 (server listening port)"},
          "server": {"type": "integer", "description": "Host agent server id (types 10–17)"},
          "disk_mount": {"type": "string", "description": "For type 13 (server disk)"},
          "agent_container": {"type": "string", "description": "For type 14 (server docker container)"},
          "method": {"type": "string"},
          "request_headers": {"type": "string"},
          "response_code": {"type": "string", "description": "Comma-separated codes, e.g. 200,201"},
          "max_redirects": {"type": "integer"},
          "ssl_verify": {"type": "integer"},
          "ssl_verify_host": {"type": "integer"},
          "ssl_cert_expire_alert": {"type": "integer"},
          "ssl_cert_expire_alert_days": {"type": "string"},
          "json_path": {"type": "string"},
          "json_expected_value": {"type": "string"},
          "json_expected_type": {"type": "string"},
          "docker": {"type": "integer"},
          "container": {"type": "string"},
          "value": {"type": "integer"},
          "proxy_host": {"type": "string"},
          "proxy_type": {"type": "integer"},
          "repeat_seconds": {"type": "integer"},
          "timeout": {"type": "integer"},
          "send_repeat_minute": {"type": "integer"},
          "alert_fail_mode": {"type": "integer", "description": "0 all, 1 majority, 2 any"},
          "parent_id": {"type": "integer"},
          "signature_id": {"type": "integer"},
          "workers": {"type": "array", "items": {"type": "integer"}},
          "notify": {"type": "array", "items": {"type": "integer"}}
        },
        "additionalProperties": true
      },
      "EnvelopeMonitor": {
        "type": "object",
        "properties": {
          "status": {"type": "integer", "enum": [0]},
          "data": {"$ref": "#/components/schemas/Monitor"}
        }
      },
      "EnvelopeMonitorList": {
        "type": "object",
        "properties": {
          "status": {"type": "integer", "enum": [0]},
          "data": {"type": "array", "items": {"$ref": "#/components/schemas/Monitor"}},
          "meta": {"$ref": "#/components/schemas/EnvelopeMeta"}
        }
      },
      "NotifyWrite": {
        "type": "object",
        "required": ["title", "type"],
        "properties": {
          "title": {"type": "string"},
          "type": {"type": "integer", "description": "0 Telegram, 1 Mattermost, 2 Gotify, 3 MAX"},
          "status": {"type": "integer"},
          "receiver": {"type": "string"},
          "json_data": {"type": "object", "additionalProperties": true}
        }
      },
      "SignatureWrite": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "project": {"type": "string"},
          "title": {"type": "string"},
          "text": {"type": "string"}
        }
      },
      "WorkerWrite": {
        "type": "object",
        "properties": {
          "title": {"type": "string"},
          "worker_threads": {"type": "integer"},
          "jobs_get_timeout": {"type": "integer"},
          "loop_timeout": {"type": "integer"},
          "response_send_timeout": {"type": "integer"},
          "logs_write_timeout": {"type": "integer"},
          "monitors": {"type": "array", "items": {"type": "integer"}},
          "dockers": {"type": "array", "items": {"type": "integer"}},
          "restart_worker": {"type": "boolean"},
          "restart_requested": {"type": "integer"}
        }
      },
      "MaintenanceWrite": {
        "type": "object",
        "properties": {
          "title": {"type": "string"},
          "start_time": {"type": "integer", "description": "Unix timestamp"},
          "finish_time": {"type": "integer", "description": "Unix timestamp, >= start_time"},
          "monitor_ids": {"type": "array", "items": {"type": "integer"}}
        }
      },
      "DockerWrite": {
        "type": "object",
        "properties": {
          "title": {"type": "string"},
          "host": {"type": "string"},
          "port": {"type": "integer"},
          "timeout": {"type": "integer"},
          "repeat_seconds": {"type": "integer"},
          "workers": {"type": "array", "items": {"type": "integer"}},
          "tls_ca_file": {"type": "string"},
          "tls_certificate": {"type": "string"},
          "tls_key": {"type": "string"}
        }
      },
      "ServerWrite": {
        "type": "object",
        "properties": {
          "title": {"type": "string"},
          "status": {"type": "integer"},
          "desired_agent_version": {"type": "string", "description": "Per-server GitHub release tag override; empty clears"},
          "regenerate_key": {"type": "boolean", "description": "If true, rotate agent_key_hash"},
          "request_agent_update": {"type": "boolean", "description": "If true, clear update_error / update_requested_at so agent can retry"}
        }
      },
      "PermissionsSet": {
        "type": "object",
        "properties": {
          "rows": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "object": {"type": "string", "enum": ["user", "group"]},
                "object_id": {"type": "integer"},
                "read": {"type": "integer"},
                "write": {"type": "integer"},
                "delete": {"type": "integer"},
                "access_read": {"type": "integer"},
                "access_write": {"type": "integer"},
                "access_change": {"type": "integer"}
              }
            }
          }
        }
      },
      "StatusResource": {
        "type": "object",
        "properties": {
          "id": {"type": "integer"},
          "title": {"type": "string"},
          "description_ru": {"type": "string"},
          "description_en": {"type": "string"},
          "check_url": {"type": "string"},
          "status": {"type": "string", "enum": ["up", "down", "maintenance", "unknown"]},
          "avg_response_time_ms": {"type": ["number", "null"]},
          "ssl_expire_time": {"type": ["integer", "null"]},
          "ssl_expire_at": {"type": ["string", "null"]},
          "availability": {"type": "object", "additionalProperties": {"type": ["number", "null"]}},
          "workers": {"type": "array", "items": {"type": "object"}},
          "maintenances": {"type": "array", "items": {"type": "object"}}
        }
      },
      "StatusResponse": {
        "type": "object",
        "properties": {
          "status": {"type": "integer", "enum": [0]},
          "generated_at": {"type": "integer"},
          "resources": {"type": "array", "items": {"$ref": "#/components/schemas/StatusResource"}},
          "maintenances": {"type": "array", "items": {"type": "object"}}
        }
      }
    }
  }
}
