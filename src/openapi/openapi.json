            }
          },
          "403": {"$ref": "#/components/responses/Forbidden"}
        }
      },
      "put": {
        "tags": ["permissions"],
        "summary": "Replace object ACL rows",
        "security": [{"BearerAuth": []}, {"ApiTokenHeader": []}],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/PermissionsSet"},
              "example": {
                "rows": [
                  {
                    "object": "user",
                    "object_id": 2,
                    "read": 1,
                    "write": 1,
                    "delete": 0,
                    "access_read": 1,
                    "access_write": 0,
                    "access_change": 0
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Saved rows",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/EnvelopeList"}
              }
            }
          },
          "403": {"$ref": "#/components/responses/Forbidden"}
        }
      },
      "patch": {
        "tags": ["permissions"],
        "summary": "Replace object ACL rows (same as PUT)",
        "security": [{"BearerAuth": []}, {"ApiTokenHeader": []}],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/PermissionsSet"}
            }
          }
        },
        "responses": {
          "200": {
            "description": "Saved rows",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/EnvelopeList"}
              }
            }
          }
        }
      }
    }
